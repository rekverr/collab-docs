# Host-machine infrastructure. Applications started with `pnpm dev` use these.
POSTGRES_USER=collab_docs
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=collab_docs
POSTGRES_PORT=5432
DATABASE_URL=postgresql://collab_docs:local-development-only@localhost:5432/collab_docs
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Authentication placeholders. Replace them locally; never use these in production.
JWT_ACCESS_SECRET=replace-with-a-long-random-value
JWT_REFRESH_SECRET=replace-with-a-different-long-random-value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Host-machine S3/MinIO access.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=local-development-minio-secret
S3_BUCKET=collab-docs
S3_REGION=us-east-1

# Host/browser-facing application URLs.
WEB_PORT=3000
API_PORT=3001
COLLAB_PORT=3002
CRDT_COMPACT_AFTER_UPDATES=100
DOCUMENT_VERSION_EVERY_UPDATES=50
WEB_URL=http://localhost:3000
INTERNAL_WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
COLLAB_URL=ws://localhost:3002
NEXT_PUBLIC_COLLAB_URL=ws://localhost:3002
INTERNAL_API_URL=http://localhost:3001

# Docker Compose injects postgres:5432, redis:6379, api:3001, collab:3002, and web:3000
# directly. This optional override is only for the S3 endpoint used inside containers.
S3_ENDPOINT_INTERNAL=http://minio:9000

REVALIDATION_SECRET=replace-with-a-long-random-value

# Isolated integration-test storage. The E2E runner refuses the normal schema and Redis DB 0.
TEST_DATABASE_URL=postgresql://collab_docs:local-development-only@localhost:5432/collab_docs?schema=collab_docs_e2e
TEST_REDIS_URL=redis://localhost:6379/15
