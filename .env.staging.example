# Staging profile template. Copy to a secret-managed staging environment and replace every value.
NODE_ENV=production
POSTGRES_USER=collab_docs
POSTGRES_PASSWORD=replace-with-staging-database-password
POSTGRES_DB=collab_docs
DATABASE_URL=postgresql://collab_docs:replace-with-staging-database-password@postgres:5432/collab_docs
REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=replace-with-a-random-staging-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-staging-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://storage.staging.example.com
S3_ACCESS_KEY=replace-with-staging-access-key
S3_SECRET_KEY=replace-with-staging-object-storage-secret
S3_BUCKET=collab-docs-staging
S3_REGION=us-east-1

WEB_URL=https://docs.staging.example.com
INTERNAL_WEB_URL=http://web:3000
API_URL=https://api.staging.example.com
INTERNAL_API_URL=http://api:3001
COLLAB_URL=wss://collab.staging.example.com
NEXT_PUBLIC_COLLAB_URL=wss://collab.staging.example.com
REVALIDATION_SECRET=replace-with-a-random-staging-revalidation-secret

API_PORT=3001
COLLAB_PORT=3002
CRDT_COMPACT_AFTER_UPDATES=100
DOCUMENT_VERSION_EVERY_UPDATES=50
